# Recommended: bash scripts/setup.sh generates unique random values in .env.
# If copying manually, replace BOTH empty values. Never commit .env.
POSTGRES_PASSWORD=
JWT_SECRET=

# Optional hardening (defaults shown). RATE_LIMIT_TRUST_PROXY=true only behind a
# proxy that overwrites X-Forwarded-For; METRICS_TOKEN gates GET /metrics.
# RATE_LIMIT_MAX_REQUESTS=1200
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_AUTH_MAX_REQUESTS=20
# RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_TRUST_PROXY=false
# METRICS_TOKEN=
