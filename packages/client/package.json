{
  "name": "@kestrel/client",
  "version": "0.3.0",
  "type": "module",
  "description": "Typed, dependency-free client for the Kestrel control-plane API",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
